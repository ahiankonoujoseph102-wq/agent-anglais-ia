APP_NAME=Talkami
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lome

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teacher_joe
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Pas de worker permanent : les tâches tournent immédiatement (aucune file d'attente à surveiller).
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Plateforme (voir config/platform.php) ---
# Nom commercial affiché partout sur le site.
PLATFORM_NAME=Talkami
PLATFORM_SHORT_NAME=Talkami
# Indicatif téléphonique ajouté aux numéros saisis sans indicatif (228 = Togo).
PHONE_DEFAULT_COUNTRY_CODE=228
PHONE_LOCAL_LENGTH=8

# --- Professeur IA : API Gemini Live (voir config/services.php et config/teacher.php) ---
# Clé créée sur https://aistudio.google.com/apikey — ne jamais la mettre dans le code.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_API_VERSION=v1alpha
# Voix du professeur : nom d’une voix listée dans la documentation Gemini (vide = voix par défaut).
GEMINI_VOICE=
# Durée de vie d'un jeton éphémère, en minutes (le navigateur en redemande un ensuite).
GEMINI_TOKEN_MINUTES=5
# Modèle texte léger pour les rédactions côté serveur (programme, messages).
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# --- Paiement manuel Mobile Money (voir config/payment.php) ---
# Disque des captures d'écran de paiement (privé). Vide = FILESYSTEM_DISK.
# Sur Laravel Cloud, le bucket privé attaché comme disque par défaut est utilisé.
PAYMENT_PROOFS_DISK=
